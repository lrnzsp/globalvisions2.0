{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.globalvisions.it"
        }
      ],
      "destination": "https://globalvisions.it/$1",
      "permanent": true
    },
    {
      "source": "/it",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/it/index.html",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "IT"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/it/store/",
      "permanent": false
    },
    {
      "source": "/store",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "IT"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/it/store/",
      "permanent": false
    },
    {
      "source": "/store/",
      "has": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "it"
        }
      ],
      "destination": "/it/store/",
      "permanent": false
    },
    {
      "source": "/store/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "IT"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/it/store/",
      "permanent": false
    },
    {
      "source": "/store",
      "destination": "/store/",
      "permanent": true
    },
    {
      "source": "/it/store",
      "destination": "/it/store/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/it/(.*)",
      "headers": [
        {
          "key": "Content-Language",
          "value": "it"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/anime.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/store/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/it/store/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/store/:path*",
      "destination": "https://gv-store.globalvisions.workers.dev/:path*"
    }
  ]
}
